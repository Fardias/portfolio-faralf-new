---
import { site } from '../../data/site';
import { t, defaultLocale } from '../../data/i18n';
import MuiIcon from '../icons/MuiIcon';

const locale = defaultLocale;
const i18n = t(locale);
---

<header class="sticky top-0 z-50 border-b-2 border-border bg-background">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-4 sm:px-6 lg:px-8">
    <a
      href="/"
      class="text-lg font-bold text-text transition-colors hover:text-primary"
    >
      FARALF
    </a>

    <nav class="hidden items-center gap-8 md:flex" aria-label="Main navigation">
      {
        site.nav.map((item) => (
          <a
            href={item.href}
            class="nav-link text-sm font-bold text-text transition-colors hover:text-primary"
            data-en={item.label}
            data-id={item.labelId}
          >
            {item.label}
          </a>
        ))
      }
      <a
        href="/#contact"
        class="nb-shadow nb-shadow-hover nav-cta inline-flex min-h-11 items-center border-2 border-border bg-primary px-4 py-2 text-sm font-bold text-white"
        data-en={i18n.nav.cta}
        data-id={t('id').nav.cta}
      >
        {i18n.nav.cta}
      </a>

      <!-- Language Switcher -->
      <button
        id="lang-toggle"
        class="nb-shadow nb-shadow-hover inline-flex min-h-11 cursor-pointer items-center gap-1.5 border-2 border-border bg-accent px-3 py-2 text-sm font-bold text-text"
        aria-label="Switch language"
      >
        <MuiIcon name="Language" size={18} className="text-text" />
        <span id="lang-label">ID</span>
      </button>
    </nav>

    <div class="flex items-center gap-2 md:hidden">
      <!-- Mobile Language Switcher -->
      <button
        id="lang-toggle-mobile"
        class="nb-shadow inline-flex min-h-11 min-w-11 cursor-pointer items-center justify-center border-2 border-border bg-accent text-sm font-bold text-text"
        aria-label="Switch language"
      >
        <span id="lang-label-mobile">ID</span>
      </button>

      <details class="group relative">
        <summary
          class="nb-shadow flex min-h-11 min-w-11 cursor-pointer list-none items-center justify-center border-2 border-border bg-surface text-primary [&::-webkit-details-marker]:hidden"
          aria-label="Toggle menu"
        >
          <span class="group-open:hidden">
            <MuiIcon name="Menu" size={24} className="text-primary" />
          </span>
          <span class="hidden group-open:block">
            <MuiIcon name="Close" size={24} className="text-primary" />
          </span>
        </summary>
        <nav
          class="nb-shadow-lg absolute right-0 mt-2 w-56 border-2 border-border bg-background p-3"
          aria-label="Mobile navigation"
        >
          <ul class="flex flex-col gap-1">
            {
              site.nav.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="nav-link block px-3 py-2.5 text-sm font-bold text-text transition-colors hover:bg-surface hover:text-primary"
                    data-en={item.label}
                    data-id={item.labelId}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
            <li class="mt-2 border-t-2 border-border pt-2">
              <a
                href="/#contact"
                class="nav-cta block border-2 border-border bg-primary px-3 py-2.5 text-center text-sm font-bold text-white transition-colors hover:bg-primary-hover"
                data-en={i18n.nav.cta}
                data-id={t('id').nav.cta}
              >
                {i18n.nav.cta}
              </a>
            </li>
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  type Locale = 'en' | 'id';

  const STORAGE_KEY = 'locale';

  function getLocale(): Locale {
    return (localStorage.getItem(STORAGE_KEY) as Locale) || 'en';
  }

  function setLocale(locale: Locale) {
    localStorage.setItem(STORAGE_KEY, locale);
  }

  function applyLocale(locale: Locale) {
    // Update all translatable elements
    document.querySelectorAll<HTMLElement>('[data-en]').forEach((el) => {
      el.textContent = locale === 'en' ? el.dataset.en! : (el.dataset.id || el.dataset.en!);
    });

    // Update lang toggle labels
    const next: Locale = locale === 'en' ? 'id' : 'en';
    const label = next.toUpperCase();
    document.querySelectorAll<HTMLElement>('#lang-label, #lang-label-mobile').forEach((el) => {
      el.textContent = label;
    });

    // Dispatch event so other components can react
    document.dispatchEvent(new CustomEvent('localechange', { detail: { locale } }));
  }

  function toggleLocale() {
    const current = getLocale();
    const next: Locale = current === 'en' ? 'id' : 'en';
    setLocale(next);
    applyLocale(next);
  }

  // Init on load
  document.addEventListener('DOMContentLoaded', () => {
    const saved = getLocale();
    applyLocale(saved);

    document.getElementById('lang-toggle')?.addEventListener('click', toggleLocale);
    document.getElementById('lang-toggle-mobile')?.addEventListener('click', toggleLocale);
  });
</script>
