---
import type { Project } from '../../data/site';
import { translations } from '../../data/site';
import MuiIcon from '../icons/MuiIcon';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const en = translations.en.cards;
const id = translations.id.cards;
---

<article
  class="nb-shadow nb-shadow-hover flex h-full flex-col overflow-hidden border-2 border-border bg-background"
>
  <div class="aspect-video overflow-hidden border-b-2 border-border bg-surface">
    <img
      src={project.image}
      alt={`${project.title} thumbnail`}
      class="h-full w-full object-cover"
      loading="lazy"
      width="640"
      height="360"
    />
  </div>
  <div class="flex flex-1 flex-col p-5 sm:p-6">
    <h3 class="text-lg font-black text-text">{project.title}</h3>
    <ul class="mt-3 flex flex-wrap gap-2" aria-label="Tech stack">
      {
        project.stack.map((tech) => (
          <li>
            <span class="border-2 border-border bg-accent px-2.5 py-1 text-xs font-bold text-text">
              {tech}
            </span>
          </li>
        ))
      }
    </ul>
    <div class="mt-auto flex flex-wrap gap-3 pt-5">
      {
        project.liveUrl && (
          <a
            href={project.liveUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="nb-shadow nb-shadow-hover inline-flex min-h-11 items-center gap-1.5 border-2 border-border bg-primary px-4 py-2 text-sm font-bold text-white"
            data-en={en.liveDemo}
            data-id={id.liveDemo}
          >
            {en.liveDemo}
            <MuiIcon name="OpenInNew" size={16} className="text-white" />
          </a>
        )
      }
      {
        project.detailsUrl && (
          <a
            href={project.detailsUrl}
            class="nb-shadow nb-shadow-hover inline-flex min-h-11 items-center gap-1.5 border-2 border-border bg-surface px-4 py-2 text-sm font-bold text-text"
            data-en={en.details}
            data-id={id.details}
          >
            {en.details}
            <MuiIcon name="ArrowForward" size={16} className="text-text" />
          </a>
        )
      }
    </div>
  </div>
</article>
