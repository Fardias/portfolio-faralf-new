---
import type { CollectionEntry } from 'astro:content';
import MuiIcon from '../icons/MuiIcon';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { data } = post;

// Extract locale from slug path: content/blog/en/... or content/blog/id/...
const locale = post.collection === 'blog' ? post.id.startsWith('en/') ? 'en' : 'id' : 'en';
const slug = post.id.replace(/^(en|id)\//, '');
const dateStr = new Date(data.date).toLocaleDateString(locale === 'en' ? 'en-US' : 'id-ID', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<a
  href={`/blog/${slug}`}
  class="nb-shadow nb-shadow-hover group flex h-full flex-col border-2 border-border bg-surface transition-all hover:-translate-y-1"
>
  <!-- Image placeholder -->
  <div class={`relative aspect-[16/9] overflow-hidden border-b-2 border-border bg-accent`}>
    <div class="flex h-full items-center justify-center">
      <MuiIcon name="Menu" size={48} className="text-primary opacity-50" />
    </div>
    <!-- Reading time badge -->
    {data.readingTime && (
      <span class="absolute right-2 top-2 border-2 border-border bg-background px-2 py-1 text-xs font-bold text-text">
        {data.readingTime} min read
      </span>
    )}
  </div>

  <div class="flex flex-1 flex-col p-5">
    <!-- Tags -->
    <div class="flex flex-wrap gap-1.5">
      {data.tags.slice(0, 3).map((tag: string) => (
        <span class="border border-border bg-primary px-2 py-0.5 text-xs font-bold text-white">
          {tag}
        </span>
      ))}
    </div>

    <!-- Title -->
    <h3 class="mt-3 text-lg font-black leading-tight text-text group-hover:text-primary transition-colors">
      {data.title}
    </h3>

    <!-- Description -->
    <p class="mt-2 text-sm leading-relaxed text-muted flex-1">
      {data.description}
    </p>

    <!-- Footer -->
    <div class="mt-4 flex items-center justify-between border-t-2 border-border pt-3">
      <span class="text-xs font-bold text-muted">{dateStr}</span>
      <span class="inline-flex items-center gap-1 text-xs font-bold text-primary group-hover:gap-2 transition-all">
        Read More
        <MuiIcon name="ArrowForward" size={14} className="text-primary" />
      </span>
    </div>
  </div>
</a>