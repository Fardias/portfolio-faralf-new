---
import { site, translations } from '../../data/site';
import MuiIcon from '../icons/MuiIcon';

const en = translations.en.hero;
const id = translations.id.hero;
---

<section
  id="hero"
  class="border-b-2 border-border bg-accent flex items-center py-12"
  style="min-height: calc(100svh - 73px);"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 w-full">
    <div class="mx-auto max-w-3xl text-center">
      <p
        class="inline-block border-2 border-border bg-primary px-4 py-1 text-sm font-bold uppercase tracking-wider text-white nb-shadow"
        data-en={en.badge}
        data-id={id.badge}
      >
        {en.badge}
      </p>
      <h1 class="mt-6 text-4xl font-black tracking-tight text-text sm:text-5xl lg:text-6xl">
        {site.name}
      </h1>
      <p
        class="mt-6 text-lg font-medium leading-relaxed text-muted sm:text-xl"
        data-en={site.tagline}
        data-id={site.taglineId}
      >
        {site.tagline}
      </p>
      <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a
          href="/#projects"
          class="nb-shadow nb-shadow-hover inline-flex min-h-11 w-full min-w-[180px] items-center justify-center gap-2 border-2 border-border bg-primary px-6 py-3 text-sm font-bold text-white sm:w-auto"
          data-en={en.cta}
          data-id={id.cta}
        >
          {en.cta}
          <MuiIcon name="ArrowForward" size={18} className="text-white" />
        </a>
        <a
          href="/#contact"
          class="nb-shadow nb-shadow-hover inline-flex min-h-11 w-full min-w-[180px] items-center justify-center border-2 border-border bg-background px-6 py-3 text-sm font-bold text-text sm:w-auto hover:bg-surface"
          data-en={en.ctaSecondary}
          data-id={id.ctaSecondary}
        >
          {en.ctaSecondary}
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  const navbar = document.querySelector('header');
  const hero = document.getElementById('hero') as HTMLElement | null;
  if (navbar && hero) {
    hero.style.minHeight = `calc(100svh - ${navbar.offsetHeight}px)`;
  }
</script>
