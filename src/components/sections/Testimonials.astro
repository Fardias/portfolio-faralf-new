---
import { site, translations } from '../../data/site';
import SectionHeading from '../ui/SectionHeading.astro';
import TestimonialCard from '../ui/TestimonialCard.astro';

const en = translations.en.sections.testimonials;
const id = translations.id.sections.testimonials;
---

<section id="testimonials" class="border-y-2 border-border bg-accent py-16 sm:py-20 lg:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <SectionHeading
      title={en.title}
      titleId={id.title}
      subtitle={en.subtitle}
      subtitleId={id.subtitle}
    />
    <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3 lg:gap-8">
      {site.testimonials.map((testimonial) => <TestimonialCard testimonial={testimonial} />)}
    </div>
  </div>
</section>
