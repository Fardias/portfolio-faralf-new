---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/ui/Navbar.astro';
import Footer from '../../components/ui/Footer.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import BlogCard from '../../components/ui/BlogCard.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => data.published !== false);

// Separate by locale
const enPosts = allPosts.filter((p) => p.id.startsWith('en/'));
const idPosts = allPosts.filter((p) => p.id.startsWith('id/'));

// Sort by date descending
enPosts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
idPosts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// Collect all unique tags
const allTags = [...new Set(allPosts.flatMap((p) => p.data.tags))];
---

<Layout title="Blog — Fardias Alfathan">
  <Navbar />

  <main>
    <!-- Page Hero -->
    <section class="border-b-2 border-border bg-accent py-12 sm:py-16">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <SectionHeading
          title="Blog"
          titleId="Blog"
          subtitle="Articles, tutorials, and thoughts on web development, design, and technology."
          subtitleId="Artikel, tutorial, dan pemikiran tentang pengembangan web, desain, dan teknologi."
        />
      </div>
    </section>

    <!-- Filter tags -->
    <section class="border-b-2 border-border bg-background py-6">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex flex-wrap items-center gap-3" id="tag-filters" role="group" aria-label="Filter by tag">
          <button
            class="filter-btn nb-shadow cursor-pointer border-2 border-border px-4 py-2 text-sm font-bold text-text"
            data-filter="all"
            data-en="All"
            data-id="Semua"
            aria-pressed="true"
          >
            All
          </button>
          {allTags.map((tag) => (
            <button
              class="filter-btn nb-shadow cursor-pointer border-2 border-border px-4 py-2 text-sm font-bold text-text"
              data-filter={tag}
              aria-pressed="false"
            >
              {tag.charAt(0).toUpperCase() + tag.slice(1)}
            </button>
          ))}
        </div>
      </div>
    </section>

    <!-- EN Posts -->
    <section class="border-b-2 border-border bg-surface py-12 sm:py-16">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <h2
          class="mb-8 text-2xl font-black tracking-tight text-text"
          data-en="English Articles"
          data-id="Artikel Bahasa Inggris"
        >
          English Articles
        </h2>
        {enPosts.length > 0 ? (
          <div class="blog-grid grid gap-6 sm:grid-cols-2 lg:grid-cols-3 lg:gap-8">
            {enPosts.map((post) => (
              <div class="blog-item" data-tags={post.data.tags.join(',')}>
                <BlogCard post={post} />
              </div>
            ))}
          </div>
        ) : (
          <p class="text-center text-base font-bold text-muted">No articles yet.</p>
        )}
      </div>
    </section>

    <!-- ID Posts -->
    <section class="border-b-2 border-border bg-background py-12 sm:py-16">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <h2
          class="mb-8 text-2xl font-black tracking-tight text-text"
          data-en="Indonesian Articles"
          data-id="Artikel Bahasa Indonesia"
        >
          Indonesian Articles
        </h2>
        {idPosts.length > 0 ? (
          <div class="blog-grid grid gap-6 sm:grid-cols-2 lg:grid-cols-3 lg:gap-8">
            {idPosts.map((post) => (
              <div class="blog-item" data-tags={post.data.tags.join(',')}>
                <BlogCard post={post} />
              </div>
            ))}
          </div>
        ) : (
          <p class="text-center text-base font-bold text-muted">Belum ada artikel.</p>
        )}
      </div>
    </section>

    <!-- Empty state for tag filter -->
    <div id="blog-empty" class="hidden border-b-2 border-border bg-background py-20 text-center">
      <p class="text-lg font-bold text-muted" data-en="No articles match this tag." data-id="Tidak ada artikel dengan tag ini.">
        No articles match this tag.
      </p>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .filter-btn[aria-pressed="true"] {
    background-color: #f97316;
    color: #ffffff;
    border-color: #0f0f0f;
  }

  .filter-btn:not([aria-pressed="true"]):hover {
    background-color: #facc15;
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0px #0f0f0f;
  }

  .blog-item {
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .blog-item.hidden {
    display: none;
  }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const items   = document.querySelectorAll<HTMLElement>('.blog-item');
  const emptyEl = document.getElementById('blog-empty')!;
  const sections = document.querySelectorAll<HTMLElement>('section.border-b-2.border-border');

  function applyFilter(filter: string) {
    let visible = 0;

    items.forEach((item) => {
      const tags = (item.dataset.tags || '').split(',');
      const match = filter === 'all' || tags.includes(filter);
      item.classList.toggle('hidden', !match);
      if (match) visible++;
    });

    // Hide/show sections based on visible items
    sections.forEach((section) => {
      const sectionItems = section.querySelectorAll<HTMLElement>('.blog-item');
      const hasVisible = Array.from(sectionItems).some(
        (item) => !item.classList.contains('hidden')
      );
      section.classList.toggle('hidden', !hasVisible && sectionItems.length > 0);
    });

    emptyEl.classList.toggle('hidden', visible > 0);

    buttons.forEach((btn) => {
      btn.setAttribute('aria-pressed', btn.dataset.filter === filter ? 'true' : 'false');
    });
  }

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => applyFilter(btn.dataset.filter!));
  });
</script>