---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/ui/Navbar.astro';
import Footer from '../../components/ui/Footer.astro';
import MuiIcon from '../../components/icons/MuiIcon';
import { getCollection, getEntry, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => data.published !== false);
  return posts.map((post) => {
    const slug = post.id.replace(/^(en|id)\//, '');
    return {
      params: { slug },
      props: {
        id: post.id,
        locale: post.id.startsWith('en/') ? ('en' as const) : ('id' as const),
      },
    };
  });
}

const { id, locale } = Astro.props as { id: string; locale: 'en' | 'id' };
const entry = await getEntry('blog', id);
if (!entry) throw new Error(`Blog entry not found: ${id}`);
const { Content } = await render(entry);
const data = entry.data;

const dateStr = new Date(data.date).toLocaleDateString(locale === 'en' ? 'en-US' : 'id-ID', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const backLabel = locale === 'en' ? 'Back to Blog' : 'Kembali ke Blog';
const readingTimeLabel = data.readingTime
  ? locale === 'en'
    ? `${data.readingTime} min read`
    : `${data.readingTime} menit baca`
  : '';
---

<Layout title={`${data.title} — Fardias Alfathan`}>
  <Navbar />

  <main>
    <!-- Article Header -->
    <article>
      <header class="border-b-2 border-border bg-accent py-12 sm:py-16">
        <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
          <a
            href="/blog"
            class="nb-shadow nb-shadow-hover inline-flex items-center gap-2 border-2 border-border bg-background px-4 py-2 text-sm font-bold text-text"
          >
            <MuiIcon name="ArrowForward" size={16} className="rotate-180 text-text" />
            {backLabel}
          </a>

          <h1 class="mt-6 text-3xl font-black tracking-tight text-text sm:text-4xl lg:text-5xl">
            {data.title}
          </h1>

          <div class="mt-4 flex flex-wrap items-center gap-4 text-sm font-bold text-muted">
            <time datetime={data.date.toISOString()}>{dateStr}</time>
            {readingTimeLabel && (
              <>
                <span aria-hidden="true">·</span>
                <span>{readingTimeLabel}</span>
              </>
            )}
          </div>

          <!-- Tags -->
          {data.tags.length > 0 && (
            <div class="mt-4 flex flex-wrap gap-2">
              {data.tags.map((tag: string) => (
                <span class="border-2 border-border bg-primary px-3 py-1 text-xs font-bold text-white">
                  {tag}
                </span>
              ))}
            </div>
          )}
        </div>
      </header>

      <!-- Article Content -->
      <div class="border-b-2 border-border bg-background py-12 sm:py-16">
        <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
          <div class="nb-shadow prose prose-lg border-2 border-border bg-surface p-6 sm:p-8 lg:p-10 max-w-none
            prose-headings:font-black prose-headings:text-text
            prose-h2:text-2xl prose-h2:mt-10 prose-h2:mb-4
            prose-h3:text-xl prose-h3:mt-8 prose-h3:mb-3
            prose-p:text-text prose-p:leading-relaxed prose-p:mb-4
            prose-a:text-primary prose-a:font-bold prose-a:no-underline hover:prose-a:underline
            prose-strong:text-text prose-strong:font-bold
            prose-code:bg-accent prose-code:px-1.5 prose-code:py-0.5 prose-code:text-sm prose-code:font-bold
            prose-pre:border-2 prose-pre:border-border prose-pre:bg-background prose-pre:mb-4
            prose-pre:shadow-[4px_4px_0px_#0f0f0f]
            [&_pre_code]:bg-transparent [&_pre_code]:p-0 [&_pre_code]:text-inherit [&_pre_code]:font-normal
            prose-li:text-text prose-li:mb-2
            prose-blockquote:border-l-4 prose-blockquote:border-primary prose-blockquote:bg-accent prose-blockquote:py-2 prose-blockquote:px-4 prose-blockquote:not-italic prose-blockquote:mb-4
            prose-img:border-2 prose-img:border-border prose-img:shadow-[4px_4px_0px_#0f0f0f] prose-img:mb-6
            [&>*:first-child]:mt-0
          ">
            <Content />
          </div>

          <!-- Share / Back -->
          <div class="mt-10 flex items-center justify-between border-t-2 border-border pt-6">
            <a
              href="/blog"
              class="nb-shadow nb-shadow-hover inline-flex items-center gap-2 border-2 border-border bg-surface px-4 py-2 text-sm font-bold text-text"
            >
              <MuiIcon name="ArrowForward" size={16} className="rotate-180 text-text" />
              {backLabel}
            </a>
          </div>
        </div>
      </div>
    </article>
  </main>

  <Footer />
</Layout>