---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/ui/Navbar.astro';
import Footer from '../../components/ui/Footer.astro';
import MuiIcon from '../../components/icons/MuiIcon';
import { site } from '../../data/site';

export function getStaticPaths() {
  return site.projects
    .filter((p) => p.slug)
    .map((project) => ({
      params: { slug: project.slug },
      props: { project },
    }));
}

const { project } = Astro.props;

const dummyContent = {
  overview:
    'This project was built to solve a real-world problem for a client. The goal was to deliver a fast, reliable, and maintainable solution that could scale with the business over time.',
  challenge:
    'The main challenge was integrating multiple data sources into a single coherent interface while keeping the user experience simple and intuitive. Performance and security were top priorities throughout the development process.',
  solution:
    'We designed a modular architecture that separates concerns cleanly. Each layer of the stack was chosen deliberately — prioritizing developer experience, runtime performance, and long-term maintainability.',
  outcome:
    'The final product launched on schedule and received positive feedback from end users. Key metrics improved significantly within the first month of deployment.',
};
---

<Layout title={`${project.title} — ${site.name}`}>
  <Navbar />
  <main>
    <!-- Hero -->
    <section class="border-b-2 border-border bg-accent py-12 sm:py-16">
      <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
        <a
          href="/#projects"
          class="nb-shadow nb-shadow-hover inline-flex items-center gap-2 border-2 border-border bg-background px-4 py-2 text-sm font-bold text-text"
        >
          <MuiIcon name="ArrowForward" size={16} className="rotate-180 text-text" />
          Back to Projects
        </a>
        <h1 class="mt-6 text-4xl font-black tracking-tight text-text sm:text-5xl">
          {project.title}
        </h1>
        <ul class="mt-4 flex flex-wrap gap-2" aria-label="Tech stack">
          {
            project.stack.map((tech) => (
              <li>
                <span class="border-2 border-border bg-primary px-3 py-1 text-sm font-bold text-white">
                  {tech}
                </span>
              </li>
            ))
          }
        </ul>
        {
          project.liveUrl && project.liveUrl !== '#' && (
            <a
              href={project.liveUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="nb-shadow nb-shadow-hover mt-6 inline-flex items-center gap-2 border-2 border-border bg-primary px-5 py-2.5 text-sm font-bold text-white"
            >
              <MuiIcon name="OpenInNew" size={16} className="text-white" />
              Live Demo
            </a>
          )
        }
      </div>
    </section>

    <!-- Project Image -->
    <section class="border-b-2 border-border bg-surface">
      <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-10">
        <div class="nb-shadow-lg border-2 border-border overflow-hidden">
          <img
            src={project.image}
            alt={`${project.title} preview`}
            class="w-full object-cover"
            width="1280"
            height="720"
          />
        </div>
      </div>
    </section>

    <!-- Content -->
    <section class="py-12 sm:py-16">
      <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
        <div class="grid gap-8 lg:grid-cols-2">

          <div class="nb-shadow border-2 border-border bg-surface p-6 sm:p-8">
            <h2 class="text-xl font-black text-text">Overview</h2>
            <p class="mt-3 text-base leading-relaxed text-muted">{dummyContent.overview}</p>
          </div>

          <div class="nb-shadow border-2 border-border bg-surface p-6 sm:p-8">
            <h2 class="text-xl font-black text-text">The Challenge</h2>
            <p class="mt-3 text-base leading-relaxed text-muted">{dummyContent.challenge}</p>
          </div>

          <div class="nb-shadow border-2 border-border bg-surface p-6 sm:p-8">
            <h2 class="text-xl font-black text-text">The Solution</h2>
            <p class="mt-3 text-base leading-relaxed text-muted">{dummyContent.solution}</p>
          </div>

          <div class="nb-shadow border-2 border-border bg-surface p-6 sm:p-8">
            <h2 class="text-xl font-black text-text">Outcome</h2>
            <p class="mt-3 text-base leading-relaxed text-muted">{dummyContent.outcome}</p>
          </div>

        </div>

        <!-- CTA -->
        <div class="mt-12 p-8 text-center sm:p-14 lg:p-20 min-h-[360px] flex flex-col items-center justify-center">
          <h2 class="text-2xl font-black text-text">Have a similar project in mind?</h2>
          <p class="mt-2 text-base font-medium text-muted">Let's talk about what we can build together.</p>
          <a
            href="/#contact"
            class="nb-shadow nb-shadow-hover mt-6 inline-flex items-center gap-2 border-2 border-border bg-primary px-6 py-3 text-sm font-bold text-white"
          >
            Get in Touch
            <MuiIcon name="ArrowForward" size={16} className="text-white" />
          </a>
        </div>

      </div>
    </section>
  </main>
  <Footer />
</Layout>
